<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Siddhi 💖</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
}

body{
height:100vh;
overflow:hidden;
font-family:sans-serif;
display:flex;
justify-content:center;
align-items:center;
background:linear-gradient(135deg,#ff9a9e,#fad0c4,#fbc2eb,#a18cd1);
background-size:400% 400%;
animation:bg 10s ease infinite;
position:relative;
}

@keyframes bg{
0%{background-position:0% 50%;}
50%{background-position:100% 50%;}
100%{background-position:0% 50%;}
}

.card{
position:relative;
width:340px;
padding:25px;
border-radius:30px;
text-align:center;
background:rgba(255,255,255,0.12);
backdrop-filter:blur(12px);
box-shadow:0 0 40px rgba(255,255,255,0.3);
animation:float 4s ease-in-out infinite;
z-index:2;
}

@keyframes float{
0%{transform:translateY(0px);}
50%{transform:translateY(-15px);}
100%{transform:translateY(0px);}
}

.card img{
width:230px;
height:320px;
object-fit:cover;
border-radius:25px;
border:4px solid white;
box-shadow:0 0 30px hotpink;
}

h1{
margin-top:20px;
font-size:42px;
color:white;
text-shadow:0 0 10px pink;
}

p{
margin-top:10px;
font-size:20px;
color:white;
}

button{
margin-top:20px;
padding:12px 28px;
border:none;
border-radius:30px;
background:white;
color:#ff4d88;
font-size:18px;
font-weight:bold;
cursor:pointer;
transition:0.3s;
}

button:hover{
transform:scale(1.08);
box-shadow:0 0 20px white;
}

.butterfly{
position:absolute;
font-size:35px;
animation:fly linear infinite;
opacity:0.8;
}

.b1{
top:90%;
left:-10%;
animation-duration:12s;
}

.b2{
top:70%;
left:-15%;
animation-duration:15s;
animation-delay:2s;
}

.b3{
top:50%;
left:-20%;
animation-duration:18s;
animation-delay:4s;
}

.b4{
top:30%;
left:-25%;
animation-duration:20s;
animation-delay:6s;
}

@keyframes fly{
0%{
transform:translateX(0) translateY(0) rotate(0deg);
}
100%{
transform:translateX(120vw) translateY(-100vh) rotate(360deg);
}
}

</style>
</head>

<body>

<div class="butterfly b1">🦋</div>
<div class="butterfly b2">🦋</div>
<div class="butterfly b3">🦋</div>
<div class="butterfly b4">🦋</div>

<div class="card">

<img src="https://i.imgur.com/8Km9tLL.jpg">

<h1>Siddhi 💖</h1>

<p>You are the cutest part of my life ✨</p>

<button onclick="showLove()">
Click Me 💌
</button>

</div>

<script>

function showLove(){
alert("I Love You Siddhi 💖✨");
}

</script>

</body>
</html>
